# LM Studio (нужен для ./up.sh --ai / up.ps1 -Ai)
# Список серверов — в ../analizator_zakupok/configs/lm_studio.yaml (не перезаписывается).
# Env ниже — fallback, если yaml пуст.
LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1
LM_STUDIO_API_KEY=lm-studio
# id модели: curl http://127.0.0.1:1234/v1/models  → поле "id"
LM_STUDIO_MODEL=qwen/qwen3-8b

# Опционально: абсолютные пути к sibling-репам
# CORE_PATH=../zakupki-core
# PARSER_PATH=../zakupki-parser
# GATEWAY_PATH=../zakupki-gateway
# CUSTOMER_PATH=../zakupki-customer
# ANALIZATOR_PATH=../analizator_zakupok

# ZAKUPKI_ANALIZATOR_LAN=auto  # auto|1|0
# ZAKUPKI_START_LM_POOL=1      # опционально автостарт lms CLI (по умолчанию выкл)
# ANALYZE_MAX_PARALLEL=1
# LM_MAX_PARALLEL=1
