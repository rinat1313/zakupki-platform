# LM Studio (нужен для ./up.sh --ai)
# ВАЖНО: не оставляйте в терминале старый export с портом 55674 —
# Docker Compose берёт переменные из shell РАНЬШЕ, чем из этого файла.
# Порт LM Studio: 1234 (лог: "HTTP server listening on port 1234")
LM_STUDIO_BASE_URL=http://10.2.12.130:1234/v1
LM_STUDIO_API_KEY=lm-studio
# id модели: curl http://10.2.12.130:1234/v1/models  → поле "id"
LM_STUDIO_MODEL=qwen/qwen3-8b

# Опционально: абсолютные пути к sibling-репам
# CORE_PATH=../zakupki-core
# PARSER_PATH=../zakupki-parser
# GATEWAY_PATH=../zakupki-gateway
# CUSTOMER_PATH=../zakupki-customer
# ANALIZATOR_PATH=../analizator_zakupok

# LM Studio: ЕДИНСТВЕННЫЙ список серверов —
#   ../analizator_zakupok/configs/lm_studio.yaml
# ./up.sh --ai этот файл НЕ перезаписывает.
# Если в yaml есть LAN IP (192.168.x) — analizator поднимается в network_mode=host
# (Docker Desktop Mac: Enable host networking).
# ZAKUPKI_ANALIZATOR_LAN=auto  # auto|1|0
# LM_STUDIO_ENDPOINTS_FILE=/app/configs/lm_studio.yaml
# ZAKUPKI_SKIP_LM_POOL=1
# ANALYZE_MAX_PARALLEL=4
# LM_MAX_PARALLEL=4
