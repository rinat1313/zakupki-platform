@@ -0,0 +1,61 @@
+package httpapi
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+)
+
+func TestRoutesRegisterWithoutPanic(t *testing.T) {
+	defer func() {
+		if rec := recover(); rec != nil {
+			t.Fatalf("routes() panicked: %v", rec)
+		}
+	}()
+	s := New(nil, nil, nil)
+	req := httptest.NewRequest(http.MethodGet, "/api/v1/health", nil)
+	rr := httptest.NewRecorder()
+	s.Mux.ServeHTTP(rr, req)
+	if rr.Code != http.StatusOK {
+		t.Fatalf("health status=%d", rr.Code)
+	}
+}
+
+func TestCategoryPathDispatch(t *testing.T) {
+	s := New(nil, nil, nil)
+	cases := []struct {
+		method string
+		path   string
+	}{
+		{http.MethodGet, "/api/v1/categories/by-search-config/abc"},
+		{http.MethodGet, "/api/v1/categories/by-search-profile/abc"},
+		{http.MethodPut, "/api/v1/categories/by-search-config/abc/auto-ai"},
+		{http.MethodPost, "/api/v1/categories/by-search-config/abc/sync"},
+		{http.MethodGet, "/api/v1/categories/my-slug/ai-configs"},
+		{http.MethodPost, "/api/v1/categories/my-slug/sync"},
+		{http.MethodPut, "/api/v1/categories/my-slug/auto-ai"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.method+" "+tc.path, func(t *testing.T) {
+			reachedHandler := false
+			func() {
+				defer func() {
+					if rec := recover(); rec != nil {
+						// nil Store в юнит-тесте — маршрут найден и хендлер вызван.
+						reachedHandler = true
+					}
+				}()
+				rr := httptest.NewRecorder()
+				req := httptest.NewRequest(tc.method, tc.path, nil)
+				s.Mux.ServeHTTP(rr, req)
+				if rr.Code == http.StatusNotFound && rr.Body.String() == "404 page not found\n" {
+					t.Fatalf("mux 404 (route not registered)")
+				}
+				reachedHandler = true
+			}()
+			if !reachedHandler {
+				t.Fatalf("handler not reached")
+			}
+		})
+	}
+}
