+++ b/internal/httpapi/categories_routes.go
@@ -0,0 +1,90 @@
+package httpapi
+
+import (
+	"net/http"
+	"strings"
+)
+
+// serveCategories разбирает /api/v1/categories/... вручную.
+//
+// net/http.ServeMux (Go 1.22+) не даёт зарегистрировать одновременно
+//   GET /api/v1/categories/{slug}/ai-configs
+// и
+//   GET /api/v1/categories/by-search-config/{id}
+// — оба матчат путь вида /categories/by-search-config/ai-configs,
+// и ни один не считается более специфичным (panic при старте).
+// То же для {slug}/auto-ai, {slug}/sync, {slug}/tenders и т.п.
+func (s *Server) serveCategories(w http.ResponseWriter, r *http.Request) {
+	path := strings.TrimPrefix(r.URL.Path, "/api/v1/categories/")
+	path = strings.Trim(path, "/")
+	if path == "" {
+		http.NotFound(w, r)
+		return
+	}
+	parts := strings.Split(path, "/")
+
+	// Статические префиксы под search config / profile.
+	if parts[0] == "by-search-config" || parts[0] == "by-search-profile" {
+		if len(parts) < 2 || strings.TrimSpace(parts[1]) == "" {
+			http.NotFound(w, r)
+			return
+		}
+		r.SetPathValue("id", parts[1])
+		switch {
+		case len(parts) == 2 && r.Method == http.MethodGet:
+			s.getCategoryBySearchConfig(w, r)
+		case len(parts) == 3 && parts[2] == "auto-ai" && r.Method == http.MethodPut:
+			s.setSearchConfigAutoAI(w, r)
+		case len(parts) == 3 && parts[2] == "sync" && r.Method == http.MethodPost:
+			s.syncSearchConfigPool(w, r)
+		default:
+			http.NotFound(w, r)
+		}
+		return
+	}
+
+	slug := parts[0]
+	r.SetPathValue("slug", slug)
+
+	switch {
+	case len(parts) == 1:
+		switch r.Method {
+		case http.MethodGet:
+			s.getCategory(w, r)
+		case http.MethodPatch:
+			s.patchCategory(w, r)
+		case http.MethodDelete:
+			s.deleteCategory(w, r)
+		default:
+			http.NotFound(w, r)
+		}
+	case len(parts) == 2 && parts[1] == "tenders" && r.Method == http.MethodDelete:
+		s.clearCategoryTenders(w, r)
+	case len(parts) == 2 && parts[1] == "jobs" && r.Method == http.MethodDelete:
+		s.clearCategoryJobs(w, r)
+	case len(parts) == 2 && parts[1] == "refresh" && r.Method == http.MethodPost:
+		s.refreshCategory(w, r)
+	case len(parts) == 2 && parts[1] == "auto-ai" && r.Method == http.MethodPut:
+		s.setCategoryAutoAI(w, r)
+	case len(parts) == 2 && parts[1] == "sync" && r.Method == http.MethodPost:
+		s.syncCategoryPool(w, r)
+	case len(parts) == 2 && parts[1] == "active-ai-config" && r.Method == http.MethodPut:
+		s.setActiveAIConfig(w, r)
+	case len(parts) == 2 && parts[1] == "ai-configs" && r.Method == http.MethodGet:
+		s.listAIConfigs(w, r)
+	case len(parts) == 2 && parts[1] == "ai-configs" && r.Method == http.MethodPost:
+		s.createAIConfig(w, r)
+	case len(parts) == 3 && parts[1] == "ai-configs":
+		r.SetPathValue("id", parts[2])
+		switch r.Method {
+		case http.MethodPut:
+			s.updateAIConfig(w, r)
+		case http.MethodDelete:
+			s.deleteAIConfig(w, r)
+		default:
+			http.NotFound(w, r)
+		}
+	default:
+		http.NotFound(w, r)
+	}
+}
